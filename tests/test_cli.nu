#!/usr/bin/env nu
# Comprehensive test script for test_cli CLI
# Generated by netabase_store
#
# Usage:
#   nu test_cli.nu                    # Run all tests
#   nu test_cli.nu --tests schema     # Run only schema tests
#   nu test_cli.nu --tests user       # Run only user tests
#   nu test_cli.nu --tests create     # Run only create tests
#   nu test_cli.nu --help             # Show help


# Test configuration
const TEST_DB = "./.test_db"
const CLI_BIN = "./target/debug/"

# Color codes for output
const COLOR_GREEN = "\u{001b}[32m"
const COLOR_RED = "\u{001b}[31m"
const COLOR_YELLOW = "\u{001b}[33m"
const COLOR_BLUE = "\u{001b}[34m"
const COLOR_RESET = "\u{001b}[0m"

# Test statistics
let test_stats = {
    total: 0,
    passed: 0,
    failed: 0,
    skipped: 0
}

# Print a section header
def print_section [title: string] {
    print $"($COLOR_BLUE)━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━($COLOR_RESET)"
    print $"($COLOR_BLUE)  ($title)($COLOR_RESET)"
    print $"($COLOR_BLUE)━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━($COLOR_RESET)"
}

# Print test result
def print_test [name: string, status: string, details: string = ""] {
    let symbol = if $status == "PASS" { "✓" } else if $status == "FAIL" { "✗" } else { "○" }
    let color = if $status == "PASS" { $COLOR_GREEN } else if $status == "FAIL" { $COLOR_RED } else { $COLOR_YELLOW }
    
    print $"  ($color)($symbol) ($name)($COLOR_RESET)"
    if ($details | str length) > 0 {
        print $"    ($details)"
    }
}

# Run a CLI command and capture output
def run_cli [...args: string] {
    let cmd = ([$CLI_BIN] ++ $args | str join " ")
    print $"    → Running: ($cmd)"
    
    try {
        let result = (do { ^$CLI_BIN ...$args } | complete)
        {
            success: ($result.exit_code == 0),
            stdout: $result.stdout,
            stderr: $result.stderr,
            exit_code: $result.exit_code
        }
    } catch {
        {
            success: false,
            stdout: "",
            stderr: $"Failed to execute command",
            exit_code: -1
        }
    }
}

# Setup test environment
def setup_test_env [] {
    print_section "Setting up test environment"
    
    # Clean up old test database
    if ($TEST_DB | path exists) {
        print $"  Removing old test database at ($TEST_DB)"
        rm -rf $TEST_DB
    }
    
    # Create fresh test database directory
    mkdir $TEST_DB
    print $"  ($COLOR_GREEN)✓ Test environment ready($COLOR_RESET)"
}

# Cleanup test environment
def cleanup_test_env [] {
    print_section "Cleaning up test environment"
    
    if ($TEST_DB | path exists) {
        rm -rf $TEST_DB
        print $"  ($COLOR_GREEN)✓ Test database removed($COLOR_RESET)"
    }
}


# Test schema commands
def test_schema [] {
    print_section "Testing Schema Commands"
    
    # Test schema show
    print_test "schema show" "RUNNING"
    let result = (run_cli "--db-path" $TEST_DB "schema" "show")
    if $result.success {
        print_test "schema show" "PASS" $"Output: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "schema show" "FAIL" $"Error: ($result.stderr)"
    }
    
    # Test schema tables
    print_test "schema tables" "RUNNING"
    let result = (run_cli "--db-path" $TEST_DB "schema" "tables")
    if $result.success {
        print_test "schema tables" "PASS" $"Output: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "schema tables" "FAIL" $"Error: ($result.stderr)"
    }
    
    # Test schema stats
    print_test "schema stats" "RUNNING"
    let result = (run_cli "--db-path" $TEST_DB "schema" "stats")
    if $result.success {
        print_test "schema stats" "PASS" $"Output: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "schema stats" "FAIL" $"Error: ($result.stderr)"
    }
}


# Test User CRUD operations
def test_user_crud [] {
    print_section "Testing User CRUD Operations"
    
    # Test CREATE with JSON
    print_test "User create (JSON)" "RUNNING"
    let json_data = '{"id":"test_id_1","name":"Test Name"}'
    let result = (run_cli "--db-path" $TEST_DB "testdefinition" "user" "create" "--json" $json_data)
    if $result.success {
        print_test "User create (JSON)" "PASS" $"Created record: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "User create (JSON)" "FAIL" $"Error: ($result.stderr)"
        return
    }
    
    # Test CREATE with RON
    print_test "User create (RON)" "RUNNING"
    let ron_data = '(id:"test_id_2",name:"Test Name 2")'
    let result = (run_cli "--db-path" $TEST_DB "testdefinition" "user" "create" "--ron" $ron_data)
    if $result.success {
        print_test "User create (RON)" "PASS" $"Created record: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "User create (RON)" "FAIL" $"Error: ($result.stderr)"
    }
    
    # Test LIST
    print_test "User list" "RUNNING"
    let result = (run_cli "--db-path" $TEST_DB "testdefinition" "user" "list")
    if $result.success {
        print_test "User list" "PASS" $"Found records: ($result.stdout | str substring 0..200)..."
    } else {
        print_test "User list" "FAIL" $"Error: ($result.stderr)"
    }
    
    # Test LIST with limit
    print_test "User list --limit" "RUNNING"
    let result = (run_cli "--db-path" $TEST_DB "testdefinition" "user" "list" "--limit" "1")
    if $result.success {
        print_test "User list --limit" "PASS" $"Limited results: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "User list --limit" "FAIL" $"Error: ($result.stderr)"
    }
    
    # Test LIST with RON format
    print_test "User list (RON output)" "RUNNING"
    let result = (run_cli "--db-path" $TEST_DB "testdefinition" "user" "list" "--format" "ron")
    if $result.success {
        print_test "User list (RON output)" "PASS" $"RON output: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "User list (RON output)" "FAIL" $"Error: ($result.stderr)"
    }
    
    # Test COUNT
    print_test "User count" "RUNNING"
    let result = (run_cli "--db-path" $TEST_DB "testdefinition" "user" "count")
    if $result.success {
        print_test "User count" "PASS" $"Count: ($result.stdout)"
    } else {
        print_test "User count" "FAIL" $"Error: ($result.stderr)"
    }
    
    # Test UPDATE with JSON
    print_test "User update (JSON)" "RUNNING"
    let update_json = '{"id":"test_id_1","name":"Updated Name"}'
    let result = (run_cli "--db-path" $TEST_DB "testdefinition" "user" "update" "--id" "test_id_1" "--json" $update_json)
    if $result.success {
        print_test "User update (JSON)" "PASS" $"Updated: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "User update (JSON)" "SKIP" $"Not fully implemented: ($result.stderr | str substring 0..100)..."
    }
}


