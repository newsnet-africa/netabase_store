    if $result.success {
        print_test "Post update (JSON)" "PASS" $"Updated: ($result.stdout | str substring 0..100)..."
    } else {
        print_test "Post update (JSON)" "SKIP" $"Not fully implemented: ($result.stderr | str substring 0..100)..."
    }
}


# Main test runner
def main [
    --tests: string = "all"  # Specific test to run (all, schema, user, post, create, etc.)
] {
    print $"($COLOR_BLUE)╔══════════════════════════════════════════════════════════════╗($COLOR_RESET)"
    print $"($COLOR_BLUE)║  CLI Comprehensive Test Suite                               ║($COLOR_RESET)"
    print $"($COLOR_BLUE)╚══════════════════════════════════════════════════════════════╝($COLOR_RESET)"
    print ""
    
    setup_test_env
    print ""
    
    # Run selected tests
    if $tests == "all" or $tests == "schema" {
        test_schema
        print ""
    }
    
    if $tests == "all" or $tests == "user" {
        test_user_crud
        print ""
    }
    
    if $tests == "all" or $tests == "post" {
        test_post_crud
        print ""
    }
    
    cleanup_test_env
    print ""
    
    print_section "Test Summary"
    print $"  Total tests run: Check output above for results"
    print $"  ($COLOR_GREEN)All tests completed!($COLOR_RESET)"
}
